[user]
	name = Zac Gibson
	email = zac.gibson@lge.com
	signingkey = B0CB0665047745BF
[init]
	defaultBranch = main
[core]
	excludesfile = /Users/zac/.gitignore_global
	editor = nvim
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
[merge]
    conflictStyle = zdiff3
[push]
	autoSetupRemote = true
[commit]
	gpgsign = false
[alias]
	# checkout gitlab MR
	mr = !sh -c 'git fetch $1 merge-requests/$2/head:mr-$1-$2 && git checkout mr-$1-$2' -
	# [s]witch [b]ranch - stash, create branch, pop stash
	sb = "!f() { git stash && git checkout -b $1 && git stash pop; }; f"

[pull]
	rebase = true
