return {
  'milanglacier/minuet-ai.nvim',
  dependencies = { 'nvim-lua/plenary.nvim' },
  config = function()
    require('minuet').setup {
      provider = 'openai_fim_compatible',
      n_completions = 1,     -- don't generate multiple candidates
      context_window = 1024, -- how much surrounding code to send

      virtualtext = {
        auto_trigger_ft = { 'python', 'javascript', 'typescript', 'lua', 'go', 'rust' },
        keymap = {
          accept      = '<C-y>',
          accept_line = '<A-a>',
          prev        = '<A-[>',
          next        = '<A-]>',
          dismiss     = '<A-e>',
        },
      },

      provider_options = {
        openai_fim_compatible = {
          api_key   = 'TERM',
          name      = 'Ollama',
          end_point = 'http://192.168.107.26:11434/v1/completions',
          model     = 'qwen2.5-coder:14b',
          optional  = {
            max_tokens = 128,
            top_p      = 0.9,
            stop       = {
              '<|endoftext|>',
              '<|fim_prefix|>',
              '<|fim_suffix|>',
              '<|fim_middle|>',
              '<|fim_pad|>',
            },
          },
        },
      },
    }
  end,
